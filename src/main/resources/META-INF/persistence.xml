<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
    version="2.2">

    <persistence-unit name="pasteleriaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>model.Ingrediente</class>
        <class>model.Lote</class>
        <class>model.Receta</class>
        <class>model.RecetaDetalle</class>
        <class>model.MovimientoStock</class>
        <class>model.Categoria</class>
        <class>model.Evento</class>
        <class>model.Pedido</class>
        <class>model.Producto</class>
        <class>model.Proveedor</class>
        <class>model.Sabor</class>
        <class>model.Trabajador</class>
        <class>model.Medida</class>
        <class>model.Agenda</class>
        <class>model.PedidoCombo</class>
        <class>model.NotificacionEntity</class>
        <class>model.Cliente</class>
        <class>model.Credencial</class>
        <class>model.PedidoProducto</class>
        <class>model.Combo</class>
        <class>model.ComboProducto</class>
        <class>model.Pago</class>
        <class>model.EstadoPedido</class>
        <class>model.Rol</class>
        <class>model.RolPermiso</class>
        <class>model.Permiso</class>
        <class>model.Transaccion</class>
        <class>model.NotificacionConfig</class>
        <class>model.InsumoFaltante</class>
        <class>model.ActionLog</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />

            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://localhost:3306/pasteleria?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC" />

            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="" />

            <property name="hibernate.hbm2ddl.auto" value="update" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />

            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.connection.autocommit" value="true" />
        </properties>
    </persistence-unit>
</persistence>